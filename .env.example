# ─────────────────────────────────────────────
#  Autogram — Bot Engine env (Render / VPS)
# ─────────────────────────────────────────────

# Supabase Postgres connection string (Settings → Database → Connection string → URI).
# Use the "Session pooler" URI for a long-running worker.
DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres

# Encryption key for Telegram sessions + AI keys (REQUIRED).
# Generate once:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Gemini models to try, in order (first that works for the task is used).
# Update names as new models ship (verify in Google AI Studio).
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-1.5-flash

# Keep-alive web server port (Render needs the process to bind a port).
PORT=10000

# How often (seconds) to re-sync tenants/config from the DB.
SYNC_INTERVAL=120

# Shared secret so ONLY your website can call the engine's /internal/* endpoints.
# Use the SAME value in the website's env. Generate any long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=
